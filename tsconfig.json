{
  "compilerOptions": {
    "target": "ESNext", "module": "ESNext", "moduleResolution": "Bundler",
    "jsx": "react-jsx", "strict": true, "noEmit": true,
    "lib": ["ESNext", "DOM", "DOM.Iterable"], "types": ["bun"],
    "skipLibCheck": true, "allowImportingTsExtensions": true
  },
  "include": ["src", "server.ts", "build.ts"]
}
